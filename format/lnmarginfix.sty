\def\@addmarginpar{%
  \@next\@marbox\@currlist{}\MFX@AssertionError
  \MFX@getypos
  \expandafter\ifx\@marbox\Mfx@inject@insert
    \mfx@injected\global\let\mfx@injected\@empty
  \else
    %% lnotes: (2) the position is \mfx@y@<n>, set when the page is built.
    \global\advance\Mfx@note@count\@ne
    \directlua{lnmfx.register(\the\Mfx@note@count, \the\@marbox)}%
    \MFX@cons\mfx@marginlist{%
      \noexpand\mfx@build@note\@currbox\@marbox
        {\noexpand\csname mfx@y@\the\Mfx@note@count\noexpand\endcsname}%
      \noexpand\mfx@build@skip{\the\marginparpush}%
    }%
    %% lnotes: (4) the nodes the kernel's \@addmarginpar leaves in the
    %% main vertical list, with an empty box, so that the body is broken
    %% into lines and pages exactly as without marginfix.
    \kern-\@pagedp
    \nointerlineskip
    \hb@xt@\columnwidth{}%
    \nointerlineskip
    \hbox{\vrule\@height\z@\@width\z@\@depth\@pagedp}%
  \fi
